# Copia questo file in .env. Non pubblicare mai il file .env reale.

# Database: lascia vuoto per usare SQLite locale.
DATABASE_URL=
SQLITE_PATH=./data/weather.db

# Posizione della stazione.
LOCATION_NAME=La mia stazione
LAT=41.9028
LON=12.4964
ELEVATION_M=20
LOCAL_TZ=Europe/Rome

# Ecowitt Cloud (necessarie per importare la stazione).
ECOWITT_APPLICATION_KEY=INSERISCI_APPLICATION_KEY
ECOWITT_API_KEY=INSERISCI_API_KEY
ECOWITT_MAC=AA:BB:CC:DD:EE:FF

# OpenWeather è il secondo modello; Open-Meteo funziona senza chiave.
OPENWEATHER_API_KEY=INSERISCI_CHIAVE_OPENWEATHER

# Rete ufficiale secondaria: nessuna chiave richiesta. Ecowitt resta primaria.
OFFICIAL_OBSERVATIONS_ENABLED=true
METAR_STATIONS=LIRF,LIRA
OFFICIAL_OBSERVATION_REFRESH_MINUTES=30
OFFICIAL_OBSERVATION_LOOKBACK_HOURS=48
# Quota massima delle statistiche ufficiali quando esiste già il dato Ecowitt.
OFFICIAL_SCORE_MAX_SHARE=0.20
OFFICIAL_MIN_OVERLAP_SAMPLES=24

# ARSIAL/SIARL: export pubblico, nessuna chiave. Roma-Lanciani è il riferimento
# regionale predefinito; in caso di manutenzione Ecowitt continua normalmente.
ARSIAL_OBSERVATIONS_ENABLED=true
ARSIAL_DASHBOARD_URL=https://siarl.arsial.it/bi/superset/dashboard/7
ARSIAL_STATION_NAME=ROMA Lanciani-SEDE ARSIAL
ARSIAL_TZ=UTC
# Override opzionale: lascia vuoto finché ARSIAL non pubblica un URL CSV fisso.
ARSIAL_CSV_URL=

# CFR Lazio: predisposto ma completamente dormiente fino all'endpoint ufficiale.
CFR_OBSERVATIONS_ENABLED=false
CFR_OBSERVATIONS_URL=
CFR_API_TOKEN=
CFR_STATION_IDS=

# Frequenze e controlli.
STATION_BACKFILL_HOURS=2
# Se una variabile resta indietro, la pipeline amplia automaticamente il recupero.
STATION_AUTO_BACKFILL_MAX_HOURS=168
STATION_STALE_MINUTES=20
# L'ingest fallisce visibilmente se Ecowitt restituisce solo campioni più vecchi.
STATION_MAX_SOURCE_AGE_MINUTES=20
FORECAST_REFRESH_MINUTES=60
FORECAST_DAYS=7
SCORE_LOOKBACK_DAYS=60
LOG_LEVEL=INFO
