<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
 <TextView android:id="@+id/widget_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meteo Pro" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_temp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— °C" android:textColor="#FFFFFF" android:textSize="28sp"/>
 <TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="In attesa di dati" android:textColor="#E3EDF5" android:textSize="12sp"/>
 <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aggiornamento secondo disponibilità Android" android:textColor="#E3EDF5" android:textSize="11sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/widget_switch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:text="Cambia stazione" android:textColor="#FFD077" android:textSize="12sp"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="Aggiorna" android:textColor="#FFD077" android:textSize="12sp"/>
 </LinearLayout>
</LinearLayout>
